<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Report Card Predictor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --desk: #2c2721;
    --desk-2: #241f1a;
    --paper: #f4efe1;
    --paper-line: #d8cfb2;
    --ink: #1c2a44;
    --ink-soft: #4a5670;
    --red-pen: #a8362a;
    --gold: #b8863a;
    --pencil: #7a7461;
    --green: #2f5d43;
    --amber: #a3752b;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    min-height:100vh;
    background:
      radial-gradient(ellipse at 30% 0%, rgba(255,255,255,0.04), transparent 60%),
      linear-gradient(180deg, var(--desk), var(--desk-2));
    font-family:'Inter', sans-serif;
    color:var(--ink);
    display:flex;
    justify-content:center;
    align-items:flex-start;
    padding:56px 20px 80px;
  }
  .sheet{
    width:100%;
    max-width:620px;
    background:var(--paper);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 37px,
      var(--paper-line) 38px
    );
    background-position: 0 118px;
    border-radius:3px;
    box-shadow:
      0 1px 0 rgba(255,255,255,0.4) inset,
      0 30px 60px rgba(0,0,0,0.45),
      0 4px 12px rgba(0,0,0,0.3);
    padding:38px 44px 44px;
    position:relative;
    transform:rotate(-0.3deg);
  }
  .pin{
    position:absolute;
    top:-10px; left:50%;
    width:18px; height:18px;
    margin-left:-9px;
    border-radius:50%;
    background: radial-gradient(circle at 35% 30%, #e8574a, var(--red-pen) 70%);
    box-shadow: 0 3px 5px rgba(0,0,0,0.4);
  }
  header{
    padding-bottom:18px;
    margin-bottom:8px;
  }
  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:var(--pencil);
    letter-spacing:0.02em;
  }
  h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:34px;
    line-height:1.08;
    margin:6px 0 8px;
    color:var(--ink);
  }
  .sub{
    font-size:14.5px;
    color:var(--ink-soft);
    max-width:46ch;
    line-height:1.5;
  }
  form{
    margin-top:22px;
  }
  .field{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:16px;
    padding:14px 0;
    border-bottom:1px solid var(--paper-line);
  }
  .field label{
    font-size:15px;
    font-weight:500;
    color:var(--ink);
    flex-shrink:0;
    width:180px;
  }
  .field .control{
    display:flex;
    align-items:baseline;
    gap:6px;
    flex-shrink:0;
  }
  .value-input{
    font-family:'IBM Plex Mono', monospace;
    font-size:15px;
    font-weight:500;
    color:var(--red-pen);
    width:56px;
    text-align:right;
    flex-shrink:0;
    background:transparent;
    border:none;
    border-bottom:1px solid var(--pencil);
    padding:2px 2px 3px;
    -moz-appearance:textfield;
  }
  .value-input:focus{
    outline:none;
    border-bottom:1px solid var(--red-pen);
  }
  .value-input::-webkit-inner-spin-button,
  .value-input::-webkit-outer-spin-button{
    -webkit-appearance:none;
    margin:0;
  }
  .control .unit{
    font-family:'IBM Plex Mono', monospace;
    font-size:13px;
    color:var(--pencil);
    white-space:nowrap;
  }
  .stamp-row{
    margin-top:28px;
    display:flex;
    justify-content:center;
  }
  button{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:16px;
    color:var(--paper);
    background:var(--ink);
    border:none;
    padding:13px 30px;
    border-radius:2px;
    cursor:pointer;
    letter-spacing:0.01em;
    transition:transform 0.15s ease, background 0.15s ease;
  }
  button:hover{ background:#111c30; }
  button:active{ transform:scale(0.97); }

  .result{
    margin-top:34px;
    display:none;
    align-items:center;
    gap:24px;
    padding-top:28px;
    border-top:1px dashed var(--paper-line);
  }
  .result.show{ display:flex; }
  .seal{
    width:104px; height:104px;
    border-radius:50%;
    border:3px solid var(--seal-color, var(--red-pen));
    color:var(--seal-color, var(--red-pen));
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    transform:rotate(-8deg);
    animation:stamp 0.35s cubic-bezier(.2,1.6,.4,1);
    position:relative;
  }
  .seal::before{
    content:'';
    position:absolute;
    inset:6px;
    border:1px solid var(--seal-color, var(--red-pen));
    border-radius:50%;
    opacity:0.5;
  }
  @keyframes stamp{
    0%{ transform:rotate(-8deg) scale(2.2); opacity:0; }
    70%{ opacity:1; }
    100%{ transform:rotate(-8deg) scale(1); opacity:1; }
  }
  .seal .score{
    font-family:'IBM Plex Mono', monospace;
    font-size:26px;
    font-weight:600;
    line-height:1;
  }
  .seal .grade{
    font-family:'Fraunces', serif;
    font-size:13px;
    margin-top:3px;
    letter-spacing:0.03em;
  }
  .remark{
    flex:1;
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:10px;
  }
  .perf-label{
    margin:0;
    font-family:'Fraunces', serif;
    font-size:17px;
    font-weight:600;
    color:var(--ink);
  }
  .pf-badge{
    font-family:'IBM Plex Mono', monospace;
    font-size:15px;
    font-weight:600;
    letter-spacing:0.06em;
    padding:8px 18px;
    border-radius:2px;
    color:var(--paper);
  }
  .pf-badge.pass{ background:var(--green); }
  .pf-badge.fail{ background:var(--red-pen); }

  .breakdown{
    margin-top:26px;
    display:none;
  }
  .breakdown.show{ display:block; }
  .breakdown-title{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:var(--pencil);
    letter-spacing:0.03em;
    margin-bottom:12px;
  }
  .row{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:9px;
  }
  .row .rlabel{
    width:150px;
    flex-shrink:0;
    font-size:12.5px;
    color:var(--ink-soft);
  }
  .row .bar-track{
    flex:1;
    height:8px;
    background:rgba(0,0,0,0.06);
    border-radius:2px;
    overflow:hidden;
  }
  .row .bar-fill{
    height:100%;
    border-radius:2px;
    transition:width 0.5s ease;
  }
  .row .rval{
    width:52px;
    flex-shrink:0;
    text-align:right;
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color:var(--ink);
  }

  .scale{
    margin-top:26px;
    padding-top:20px;
    border-top:1px solid var(--paper-line);
  }
  .scale-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:10px 18px;
  }
  .scale-item{
    display:flex;
    align-items:baseline;
    gap:8px;
  }
  .scale-item .dot{
    width:8px; height:8px;
    border-radius:50%;
    flex-shrink:0;
  }
  .scale-item .glabel{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:14px;
    width:24px;
    flex-shrink:0;
  }
  .scale-item .grange{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color:var(--ink-soft);
  }

  @media (max-width:480px){
    .sheet{ padding:28px 22px 32px; }
    h1{ font-size:27px; }
    .field{ flex-direction:column; align-items:stretch; gap:8px; }
    .field label{ width:auto; }
    .result{ flex-direction:column; text-align:center; }
    .row .rlabel{ width:110px; }
  }
</style>
</head>
<body>
  <div class="sheet">
    <div class="pin"></div>
    <header>
      <div class="eyebrow">STUDENT PERFORMANCE RECORD</div>
      <h1>The Marks Predictor</h1>
      <p class="sub">Enter a student's study habits below to estimate their likely final marks.</p>
    </header>

    <div id="form">
      <div class="field">
        <label for="hoursNum">Study hours</label>
        <div class="control">
          <input type="number" class="value-input" id="hoursNum" min="0" max="24" step="0.5" value="0">
          <span class="unit">/ 24 hrs</span>
        </div>
      </div>
      <div class="field">
        <label for="attendanceNum">Attendance</label>
        <div class="control">
          <input type="number" class="value-input" id="attendanceNum" min="0" max="100" step="1" value="0">
          <span class="unit">/ 100%</span>
        </div>
      </div>
      <div class="field">
        <label for="assignmentNum">Assignment score</label>
        <div class="control">
          <input type="number" class="value-input" id="assignmentNum" min="0" max="100" step="1" value="0">
          <span class="unit">/ 100</span>
        </div>
      </div>
      <div class="field">
        <label for="previousNum">Previous marks</label>
        <div class="control">
          <input type="number" class="value-input" id="previousNum" min="0" max="100" step="1" value="0">
          <span class="unit">/ 100</span>
        </div>
      </div>

      <div class="stamp-row">
        <button type="button" id="generateBtn">Generate report card</button>
      </div>
    </div>

    <div class="result" id="result">
      <div class="seal" id="seal">
        <div class="score" id="sealScore">--</div>
        <div class="grade" id="sealGrade">--</div>
      </div>
      <div class="remark">
        <span class="pf-badge" id="pfBadge">--</span>
        <p class="perf-label" id="perfLabel">--</p>
      </div>
    </div>

    <div class="scale">
      <div class="breakdown-title">GRADING SCALE</div>
      <div class="scale-grid">
        <div class="scale-item"><span class="dot" style="background:#b8863a;"></span><span class="glabel">A+</span><span class="grange">90 – 100</span></div>
        <div class="scale-item"><span class="dot" style="background:#2f5d43;"></span><span class="glabel">A</span><span class="grange">80 – 89</span></div>
        <div class="scale-item"><span class="dot" style="background:#2c5b73;"></span><span class="glabel">B</span><span class="grange">70 – 79</span></div>
        <div class="scale-item"><span class="dot" style="background:#a3752b;"></span><span class="glabel">C</span><span class="grange">60 – 69</span></div>
        <div class="scale-item"><span class="dot" style="background:#b3541f;"></span><span class="glabel">D</span><span class="grange">50 – 59</span></div>
        <div class="scale-item"><span class="dot" style="background:#8a6a2e;"></span><span class="glabel">E</span><span class="grange">35 – 49</span></div>
        <div class="scale-item"><span class="dot" style="background:#a8362a;"></span><span class="glabel">F</span><span class="grange">Below 35</span></div>
      </div>
    </div>

  </div>

<script>
  // Coefficients extracted from the trained model (joblib-pickled LinearRegression)
  const COEF = {
    hours: 3.02630255,
    attendance: 0.23615896,
    assignment: 0.1483488,
    previous: 0.25410059
  };
  const INTERCEPT = 13.523579332059171;

  const ids = ['hours','attendance','assignment','previous'];

  ids.forEach(id=>{
    const num = document.getElementById(id+'Num');
    const min = parseFloat(num.min);
    const max = parseFloat(num.max);

    num.addEventListener('blur', ()=>{
      let v = parseFloat(num.value);
      if (isNaN(v)) v = min;
      if (v > max) v = max;
      if (v < min) v = min;
      num.value = v;
    });
  });

  function gradeInfo(score){
    if (score >= 90) return { grade:'A+', color:'#b8863a', performance:'Outstanding performance' };
    if (score >= 80) return { grade:'A',  color:'#2f5d43', performance:'Excellent performance' };
    if (score >= 70) return { grade:'B',  color:'#2c5b73', performance:'Very good performance' };
    if (score >= 60) return { grade:'C',  color:'#a3752b', performance:'Good performance' };
    if (score >= 50) return { grade:'D',  color:'#b3541f', performance:'Average performance' };
    if (score >= 35) return { grade:'E',  color:'#8a6a2e', performance:'Marginal pass' };
    return { grade:'F', color:'#a8362a', performance:'Poor performance' };
  }

  document.getElementById('generateBtn').addEventListener('click', function(){
    const vals = {
      hours: parseFloat(document.getElementById('hoursNum').value),
      attendance: parseFloat(document.getElementById('attendanceNum').value),
      assignment: parseFloat(document.getElementById('assignmentNum').value),
      previous: parseFloat(document.getElementById('previousNum').value)
    };

    const contributions = {
      base: INTERCEPT,
      hours: COEF.hours * vals.hours,
      attendance: COEF.attendance * vals.attendance,
      assignment: COEF.assignment * vals.assignment,
      previous: COEF.previous * vals.previous
    };

    let raw = Object.values(contributions).reduce((a,b)=>a+b, 0);
    const allZero = vals.hours === 0 && vals.attendance === 0 && vals.assignment === 0 && vals.previous === 0;
    const displayScore = allZero ? 0 : Math.max(0, Math.min(100, raw));
    const info = gradeInfo(displayScore);

    const seal = document.getElementById('seal');
    seal.style.setProperty('--seal-color', info.color);
    seal.classList.remove('show');
    void seal.offsetWidth; // restart animation
    seal.style.animation = 'none';
    void seal.offsetWidth;
    seal.style.animation = '';

    document.getElementById('sealScore').textContent = displayScore.toFixed(1);
    document.getElementById('sealGrade').textContent = info.grade;
    const pfBadge = document.getElementById('pfBadge');
    const passed = displayScore >= 35;
    pfBadge.textContent = passed ? 'PASS' : 'FAIL';
    pfBadge.classList.remove('pass', 'fail');
    pfBadge.classList.add(passed ? 'pass' : 'fail');
    document.getElementById('perfLabel').textContent = info.performance;
    document.getElementById('result').classList.add('show');
  });
</script>
</body>
</html>
